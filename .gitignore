# 虚拟环境与构建产物
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/

# 凭据：令牌只允许经环境变量或启动参数传入，不得入仓
.env
.env.*
*.token
tokens*.txt
secrets*

# 联调抓取、自对弈数据与运行日志（体积大且可重生成）
data/
logs/
# 模型产物：仅实验用途。若某个模型成为默认档位的运行必需项，
# 再显式提交它（`git add -f models/xxx.json`）并把默认档位切过去。
models/

# 自动刷新的状态页（由 tools/iterate_loop.py 生成，避免每次刷新产生提交噪声）
notes/STATUS.md
data/experiments/.lock
notes/manifest-pre-cut.txt
notes/manifest-post-cut.txt
data/experiments/logs/
notes/.thread_seen_a

# B 的 verify 产物：运行时状态与大体积可再生成文件忽略；证据类小文件（seedcheck 日志、
# *-latest.json、win_rate_table.json、spotcheck 文本）保留入库
verify/out/watch.pid
verify/out/watch_supervisor.pid
verify/out/watch.state.json
verify/out/watch.status
verify/out/watch.log
verify/out/inbox.log
verify/out/clone_samples.npz
verify/out/clone_model.pkl
