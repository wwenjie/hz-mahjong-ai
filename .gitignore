# 虚拟环境与构建产物
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/

# 凭据：令牌只允许经环境变量或启动参数传入，不得入仓
.env
.env.*
*.token
tokens*.txt
secrets*

# 联调抓取、自对弈数据与运行日志（体积大且可重生成）
data/
logs/
# 模型产物：仅实验用途。若某个模型成为默认档位的运行必需项，
# 再显式提交它（`git add -f models/xxx.json`）并把默认档位切过去。
models/

# 自动刷新的状态页（由 tools/iterate_loop.py 生成，避免每次刷新产生提交噪声）
notes/STATUS.md
data/experiments/.lock
notes/manifest-pre-cut.txt
notes/manifest-post-cut.txt
data/experiments/logs/
notes/.thread_seen_a

# B 的 verify 产物：运行时状态与大体积可再生成文件忽略；证据类小文件（seedcheck 日志、
# *-latest.json、win_rate_table.json、spotcheck 文本）保留入库
verify/out/watch.pid
verify/out/watch_supervisor.pid
verify/out/watch.state.json
verify/out/watch.status
verify/out/watch.log
verify/out/inbox.log
verify/out/clone_samples.npz
verify/out/clone_model.pkl

# 小龙虾（C）的运行时噪声：巡检心跳、告警队列、委派原始事件流、鉴权续期日志 —— 可再生成，不入库。
# 注意 agent/out/ 整体**是证据目录**（已有一批 audit 产物入库），所以只逐项忽略噪声文件，
# 不要整目录忽略，否则新证据会被静默挡住。
agent/out/patrol.log
agent/out/patrol.status
agent/out/patrol.state.json
agent/out/alerts.log
agent/out/codemaker-delegate.log
agent/out/last-delegate.json
agent/out/last-delegate.err
agent/out/mcp-auth-refresh.log

# 训练检查点与导出的模型产物：体积大且可再生成；records/ 是证据，保留入库。
# 若某个产物成为必需项，显式提交（`git add -f research/artifacts/xxx.json`，与 models/ 约定一致）。
research/ckpt/
research/artifacts/


# rl2 并入产物（2026-10-08 拷贝自 majiang_rl2）
# 仅忽略大体积可再生成的 checkpoint；outputs/（审计/微调日志）与 records/rl2/（A/B 判决 JSON）
# 属证据类小文件，按仓内既有约定（见上文 records/ 注释）保留入库。
runs/
outputs/*.pt
outputs/*.npz
outputs/*.ckpt

# agent 工作区噪声（2026-10-08 agent-e 修补单，提交 GitHub 前收口）：
# chunks/ 是可再生成的数据分块（stage-a-dataset-chunks 123M npz 等），非证据；
# work/ 是各 agent scratch；memory/与 MEMORY.md/USER.md 是 agent 记忆/会话状态。
# 注意：AGENTS.md/SOUL.md/IDENTITY.md/TOOLS.md 是 persona 文件，必须保留入库。
agent/*/work/
agent/*/memory/
agent/*/MEMORY.md
agent/*/USER.md
agent/out/*-chunks/
# （EOF 文件已于早前消失，无需规则；10/3 heredoc 误操作产物）

# 2026-10-08 提交前收口补充：
# 根级 agent 私人状态（agent-e 规则只盖住 agent/*/，根级需单列）
agent/USER.md
agent/DREAMS.md
agent/memory/
# 部署脚本含内网拓扑/主机 IP，推公开仓前不入库
agent/deploy/
# agent persona 目录内嵌套的独立 git 仓（防 submodule 化）
agent/*/.git/
# Cython 编译产物（源 .pyx 已入库）
src/majiang/rules/shanten_fast.cpython-*.so
# agent/out 运行日志噪声（证据类 txt/json/md 保留入库）
agent/out/*.log
# GBDT 训练产物（可再生成，2.1M 二进制）
agent/out/stage-b-gbdt.joblib

# 2026-10-08 提交前收尾：编译产物 / 备份文件
src/majiang/rules/shanten_fast.c
src/majiang/rules/shanten_fast.cpython-*.so
notes/THREAD.md.bak-*

# 嵌套 agent 仓目录（各自带 .git，主仓不追踪，由各自仓自行提交）
agent/agent-e-agent-e-coordinator/
agent/agent-e-researcher/
agent/agent-e-reviewer/
agent/agent-e-writer/
agent/agentb-coordinator/
agent/agentb-researcher/
agent/agentb-reviewer/
agent/agentb-writer/
agent/team-researcher/
agent/team-reviewer/
agent/team-team-coordinator/
agent/team-writer/
